# Public build-time values only. Vite embeds every VITE_* value in browser assets.
# Never put client secrets, tokens, passwords, database URLs, or other secrets here.
# API and short-link redirects share this origin. Do not include a trailing slash.
VITE_API_ORIGIN=http://localhost:3000
# Browser origin used for canonical, Open Graph, sitemap, robots, and hreflang URLs.
VITE_SITE_ORIGIN=http://localhost:5173
# Replace these public legal placeholders only after the operator details are verified.
VITE_LEGAL_NAME=
VITE_LEGAL_CONTACT_EMAIL=
