# Public build-time values only. Never put client secrets or tokens in VITE_* variables.
# API and redirects share this origin; allow the frontend origin in backend CORS_ALLOWED_ORIGINS.
VITE_API_ORIGIN=http://localhost:3000
# Required by production builds so canonical, sitemap, and robots URLs use the deployed origin.
VITE_SITE_ORIGIN=
VITE_LEGAL_NAME=
VITE_LEGAL_CONTACT_EMAIL=
