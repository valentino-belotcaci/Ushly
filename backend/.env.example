NODE_ENV="development"
HOST="127.0.0.1"
PORT=3000
DATABASE_URL="postgresql://ushly:change_me@127.0.0.1:5432/ushly"
# Readiness probe deadline in milliseconds (1-5000).
DATABASE_READY_TIMEOUT_MS=1000
REDIS_URL="redis://localhost:6379"
REDIS_CONNECT_TIMEOUT_MS="1000"
REDIS_MAX_RECONNECT_ATTEMPTS="5"
REDIS_RECONNECT_BASE_DELAY_MS="100"
IP_HASH_SECRET="replace_with_a_different_long_random_secret_value"
CLICK_RETENTION_DAYS="90"
# Local benchmark only; never enable this in production.
LOAD_TEST_MODE="false"
LOAD_TEST_RATE_LIMIT_MAX="100000"
JWT_SECRET="replace_with_a_long_random_secret_value"
COOKIE_NAME="ushly_session"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
COOKIE_MAX_AGE=86400000
# Exact browser origins only: scheme + host + optional port, with no trailing slash.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
TRUST_PROXY=""
# Access-token lifetime in seconds (60–3600).
ACCESS_TOKEN_TTL_SECONDS=900
# Google OAuth is disabled when every GOOGLE_* value is absent. The callback is
# served by this backend, so its origin must be the public backend origin.
GOOGLE_CLIENT_ID="replace_with_google_client_id"
GOOGLE_CLIENT_SECRET="replace_with_google_client_secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/auth/google/callback"
GOOGLE_OAUTH_STATE_TTL_SECONDS="300"

# Production overrides belong in the hosting provider, not this tracked file:
# NODE_ENV="production"
# HOST="0.0.0.0"
# COOKIE_SECURE="true"
# COOKIE_SAME_SITE="lax" # use "none" only for a genuinely cross-site frontend
# CORS_ALLOWED_ORIGINS="https://app.example.com"
# TRUST_PROXY="127.0.0.1" # set only to the real trusted proxy/CIDR
# GOOGLE_OAUTH_REDIRECT_URI="https://api.example.com/auth/google/callback"
# Generate unique production values for DATABASE_URL, REDIS_URL,
# JWT_SECRET, IP_HASH_SECRET, and GOOGLE_CLIENT_SECRET in a secret manager.
