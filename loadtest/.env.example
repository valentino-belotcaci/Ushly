# Dedicated local load-test environment. Never point this at the development or production database.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://ushly:change_me_in_env_file@127.0.0.1:5433/ushly_loadtest
DATABASE_READY_TIMEOUT_MS=1000
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_MAX_RECONNECT_ATTEMPTS=5
REDIS_RECONNECT_BASE_DELAY_MS=100
IP_HASH_SECRET=replace_with_a_different_load_test_secret_value
CLICK_RETENTION_DAYS=90
LOAD_TEST_MODE=true
LOAD_TEST_RATE_LIMIT_MAX=100000
JWT_SECRET=replace_with_a_long_load_test_jwt_secret_value
ACCESS_TOKEN_TTL_SECONDS=900
COOKIE_NAME=ushly_loadtest_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=86400000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
TRUST_PROXY=
